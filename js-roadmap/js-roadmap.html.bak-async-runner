let state = {
  xp: 0, level: 1, streak: 0,
  completed: [], solvedChallenges: [],
  achievements: [], lastVisit: null,
  settings: { theme:'dark', accent:'#00d4ff', animations:true, sound:false }
};

function loadState() {
  try {
    const saved = localStorage.getItem('jsquest-state');
    if (saved) state = { ...state, ...JSON.parse(saved) };
  } catch(e) { console.warn('State load error', e); }
  applySettings();
  updateStreak();
}

function saveState() {
  try { localStorage.setItem('jsquest-state', JSON.stringify(state)); } catch(e) {}
}

function updateStreak() {
  const today = new Date().toDateString();
  const last = state.lastVisit;
  if (!last) { state.streak = 1; }
  else if (last === today) { /* same day */ }
  else {
    const diff = (new Date(today) - new Date(last)) / 86400000;
    if (diff === 1) state.streak += 1;
    else if (diff > 1) state.streak = 1;
  }
  state.lastVisit = today;
  saveState();
}

function getXpForLevel(lvl) { return lvl * 500; }

function addXP(amount, label='') {
  state.xp += amount;
  // Level up check
  let leveled = false;
  while (state.xp >= getXpForLevel(state.level)) {
    state.xp -= getXpForLevel(state.level);
    state.level++;
    leveled = true;
  }
  saveState();
  updateNavStats();
  showXPPopup(amount, label);
  if (leveled) showXPPopup(0, `🎉 LEVEL ${state.level}!`);
  checkAchievements();
}

function getRank() {
  let rank = RANKS[0];
  for (const r of RANKS) { if (state.xp + (state.level-1)*500 >= r.minXp || state.level >= r.minLevel) rank = r; }
  for (const r of RANKS) { if (state.level >= r.minLevel) rank = r; }
  return rank.label;
}


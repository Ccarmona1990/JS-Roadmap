<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, viewport-fit=cover">
<title>JS QUEST — Master JavaScript</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=JetBrains+Mono:wght@300;400;700&family=Rajdhani:wght@300;400;600;700&display=swap" rel="stylesheet">
<style>
/* ============================================
   CSS VARIABLES & RESET
   ============================================ */
:root {
  --bg-primary: #0a0a0f;
  --bg-secondary: #0f0f1a;
  --bg-card: rgba(15,15,30,0.85);
  --bg-glass: rgba(20,20,45,0.6);
  --accent-blue: #00d4ff;
  --accent-purple: #7c3aed;
  --accent-cyan: #06ffd4;
  --accent-orange: #ff6b35;
  --accent-green: #00ff88;
  --accent-pink: #ff2d78;
  --text-primary: #e8e8f0;
  --text-secondary: #8888aa;
  --text-dim: #444466;
  --border-glow: rgba(0,212,255,0.3);
  --shadow-neon: 0 0 20px rgba(0,212,255,0.4);
  --shadow-purple: 0 0 20px rgba(124,58,237,0.4);
  --radius: 12px;
  --radius-lg: 20px;
  --transition: 0.3s cubic-bezier(0.4,0,0.2,1);
  --font-display: 'Orbitron', monospace;
  --font-mono: 'JetBrains Mono', monospace;
  --font-body: 'Rajdhani', sans-serif;
}
[data-theme="light"] {
  --bg-primary: #f0f0f8;
  --bg-secondary: #e4e4f0;
  --bg-card: rgba(255,255,255,0.9);
  --bg-glass: rgba(230,230,250,0.7);
  --text-primary: #1a1a2e;
  --text-secondary: #444466;
  --text-dim: #9999bb;
  --border-glow: rgba(0,150,200,0.3);
}
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body {
  font-family: var(--font-body);
  background: var(--bg-primary);
  color: var(--text-primary);
  min-height: 100vh;
  overflow-x: hidden;
  transition: background var(--transition), color var(--transition);
}
/* ============================================
   ANIMATED BACKGROUND
   ============================================ */
#bg-canvas {
  position: fixed; top:0; left:0; width:100%; height:100%;
  z-index: 0; pointer-events: none; opacity: 0.4;
}
/* ============================================
   LAYOUT
   ============================================ */
#app { position: relative; z-index: 1; }
/* ============================================
   NAVIGATION
   ============================================ */
nav {
  position: fixed; top:0; left:0; right:0; z-index: 1000;
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 2rem; height: 64px;
  background: rgba(10,10,15,0.9);
  backdrop-filter: blur(20px);
  border-bottom: 1px solid rgba(0,212,255,0.15);
}
.nav-logo {
  font-family: var(--font-display);
  font-size: 1.3rem; font-weight: 900;
  background: linear-gradient(135deg, var(--accent-blue), var(--accent-purple));
  -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  cursor: pointer;
}
.nav-links { display: flex; gap: 0.5rem; }
.nav-btn {
  background: transparent; border: none;
  color: var(--text-secondary); font-family: var(--font-body);
  font-size: 0.9rem; font-weight: 600; padding: 0.4rem 0.8rem;
  cursor: pointer; border-radius: 6px;
  transition: var(--transition); letter-spacing: 1px; text-transform: uppercase;
}
.nav-btn:hover, .nav-btn.active { color: var(--accent-cyan); background: rgba(0,212,255,0.1); }
.nav-right { display: flex; align-items: center; gap: 1rem; }
.xp-badge {
  display: flex; align-items: center; gap: 0.5rem;
  background: var(--bg-glass); border: 1px solid var(--border-glow);
  border-radius: 20px; padding: 0.3rem 0.8rem;
  font-family: var(--font-display); font-size: 0.75rem;
}
.xp-badge .level { color: var(--accent-orange); font-weight: 700; }
.xp-badge .xp-val { color: var(--accent-cyan); }
.streak-badge {
  display: flex; align-items: center; gap: 0.3rem;
  color: var(--accent-orange); font-size: 0.85rem; font-weight: 700;
}
/* ============================================
   PAGES
   ============================================ */
.page { display: none; min-height: 100vh; padding-top: 64px; }
.page.active { display: block; }
/* Landing overrides - flexbox layout */
#page-landing.active { display: flex; flex-direction: column; }
/* ============================================
   LANDING PAGE
   ============================================ */
#page-landing {
  display: flex; flex-direction: column; align-items: center;
  justify-content: center; text-align: center; padding: 80px 2rem 4rem;
  min-height: 100vh; position: relative;
}
.hero-tag {
  display: inline-block;
  background: rgba(0,212,255,0.1); border: 1px solid var(--accent-blue);
  color: var(--accent-cyan); font-family: var(--font-mono);
  font-size: 0.75rem; padding: 0.3rem 1rem; border-radius: 20px;
  letter-spacing: 3px; text-transform: uppercase; margin-bottom: 2rem;
  animation: pulse-border 2s infinite;
}
@keyframes pulse-border {
  0%,100% { box-shadow: 0 0 5px rgba(0,212,255,0.3); }
  50% { box-shadow: 0 0 20px rgba(0,212,255,0.8); }
}
.hero-title {
  font-family: var(--font-display);
  font-size: clamp(3rem, 8vw, 6rem); font-weight: 900;
  line-height: 1.1; margin-bottom: 1rem;
}
.hero-title .line1 { color: var(--text-primary); display: block; }
.hero-title .line2 {
  display: block;
  background: linear-gradient(135deg, var(--accent-blue) 0%, var(--accent-purple) 50%, var(--accent-pink) 100%);
  -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  filter: drop-shadow(0 0 30px rgba(0,212,255,0.5));
}
.hero-sub {
  font-size: 1.2rem; color: var(--text-secondary);
  max-width: 600px; line-height: 1.7; margin-bottom: 3rem;
}
.hero-stats {
  display: flex; gap: 3rem; justify-content: center;
  margin-bottom: 3rem; flex-wrap: wrap;
}
.hero-stat { text-align: center; }
.hero-stat .num {
  font-family: var(--font-display); font-size: 2rem; font-weight: 700;
  color: var(--accent-cyan); display: block;
}
.hero-stat .label { font-size: 0.8rem; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 2px; }
.cta-group { display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center; }
.btn-primary {
  background: linear-gradient(135deg, var(--accent-blue), var(--accent-purple));
  border: none; color: white; font-family: var(--font-display);
  font-size: 0.9rem; font-weight: 700; padding: 0.9rem 2.5rem;
  border-radius: 50px; cursor: pointer; letter-spacing: 2px;
  text-transform: uppercase; transition: var(--transition);
  box-shadow: 0 0 30px rgba(0,212,255,0.4);
}
.btn-primary:hover { transform: translateY(-3px) scale(1.05); box-shadow: 0 0 50px rgba(0,212,255,0.7); }
.btn-secondary {
  background: transparent;
  border: 2px solid rgba(0,212,255,0.5); color: var(--accent-cyan);
  font-family: var(--font-display); font-size: 0.9rem; font-weight: 700;
  padding: 0.9rem 2.5rem; border-radius: 50px; cursor: pointer;
  letter-spacing: 2px; text-transform: uppercase; transition: var(--transition);
}
.btn-secondary:hover { background: rgba(0,212,255,0.1); border-color: var(--accent-cyan); transform: translateY(-3px); }
/* Feature cards */
.features-grid {
  display: grid; grid-template-columns: repeat(auto-fit, minmax(220px,1fr));
  gap: 1.5rem; max-width: 1100px; width: 100%; margin: 5rem auto 0;
}
.feat-card {
  background: var(--bg-glass); border: 1px solid rgba(255,255,255,0.06);
  border-radius: var(--radius-lg); padding: 2rem;
  transition: var(--transition); backdrop-filter: blur(10px);
  text-align: left;
}
.feat-card:hover { transform: translateY(-8px); border-color: var(--border-glow); box-shadow: var(--shadow-neon); }
.feat-icon { font-size: 2.5rem; margin-bottom: 1rem; display: block; }
.feat-title { font-family: var(--font-display); font-size: 0.9rem; color: var(--accent-cyan); margin-bottom: 0.5rem; }
.feat-desc { font-size: 0.9rem; color: var(--text-secondary); line-height: 1.6; }
/* ============================================
   ROADMAP PAGE
   ============================================ */
#page-roadmap { padding: 80px 2rem 4rem; }
.roadmap-header {
  text-align: center; padding: 3rem 0 2rem;
}
.page-title {
  font-family: var(--font-display); font-size: 2.5rem; font-weight: 900;
  background: linear-gradient(135deg, var(--accent-blue), var(--accent-purple));
  -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  margin-bottom: 0.5rem;
}
.page-sub { color: var(--text-secondary); font-size: 1rem; }
/* Player card */
.player-card {
  max-width: 800px; margin: 2rem auto;
  background: var(--bg-glass); border: 1px solid var(--border-glow);
  border-radius: var(--radius-lg); padding: 2rem;
  backdrop-filter: blur(10px);
  display: grid; grid-template-columns: auto 1fr auto; gap: 2rem; align-items: center;
}
.player-avatar {
  width: 80px; height: 80px; border-radius: 50%;
  background: linear-gradient(135deg, var(--accent-purple), var(--accent-blue));
  display: flex; align-items: center; justify-content: center;
  font-size: 2.5rem; border: 3px solid var(--accent-cyan);
  box-shadow: 0 0 20px rgba(0,212,255,0.5);
  animation: avatar-pulse 3s infinite;
}
@keyframes avatar-pulse {
  0%,100% { box-shadow: 0 0 20px rgba(0,212,255,0.5); }
  50% { box-shadow: 0 0 40px rgba(0,212,255,0.9), 0 0 60px rgba(124,58,237,0.5); }
}
.player-info h2 { font-family: var(--font-display); font-size: 1.2rem; color: var(--text-primary); }
.player-rank { color: var(--accent-orange); font-size: 0.85rem; font-weight: 700; margin-bottom: 0.8rem; letter-spacing: 2px; }
.xp-bar-wrap { background: rgba(255,255,255,0.05); border-radius: 10px; height: 8px; overflow: hidden; }
.xp-bar-fill {
  height: 100%; background: linear-gradient(90deg, var(--accent-blue), var(--accent-purple), var(--accent-cyan));
  border-radius: 10px; transition: width 1s cubic-bezier(0.4,0,0.2,1);
  position: relative; overflow: hidden;
}
.xp-bar-fill::after {
  content: ''; position: absolute; top: 0; left: -100%; width: 100%; height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent);
  animation: shimmer 2s infinite;
}
@keyframes shimmer { to { left: 100%; } }
.player-stats-mini {
  display: grid; grid-template-columns: 1fr 1fr; gap: 0.8rem;
  text-align: center;
}
.stat-mini .val { font-family: var(--font-display); font-size: 1.3rem; color: var(--accent-cyan); display: block; }
.stat-mini .lbl { font-size: 0.7rem; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 1px; }
/* Roadmap sections */
.roadmap-section { max-width: 1100px; margin: 3rem auto; }
.section-header {
  display: flex; align-items: center; gap: 1rem; margin-bottom: 2rem;
  padding-bottom: 1rem; border-bottom: 1px solid rgba(255,255,255,0.06);
}
.section-badge {
  background: linear-gradient(135deg, var(--accent-blue), var(--accent-purple));
  border-radius: 8px; padding: 0.4rem 0.8rem;
  font-family: var(--font-display); font-size: 0.65rem; color: white;
  text-transform: uppercase; letter-spacing: 2px; white-space: nowrap;
}
.section-title { font-family: var(--font-display); font-size: 1.2rem; color: var(--text-primary); }
.section-prog { margin-left: auto; color: var(--text-secondary); font-size: 0.85rem; font-family: var(--font-mono); }
/* Lesson nodes grid */
.lessons-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px,1fr));
  gap: 1rem;
}
.lesson-node {
  background: var(--bg-glass); border: 1px solid rgba(255,255,255,0.06);
  border-radius: var(--radius); padding: 1.2rem;
  cursor: pointer; transition: var(--transition);
  position: relative; overflow: hidden;
  backdrop-filter: blur(5px);
}
.lesson-node::before {
  content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
  background: linear-gradient(90deg, var(--accent-blue), var(--accent-purple));
  transform: scaleX(0); transform-origin: left;
  transition: transform var(--transition);
}
.lesson-node:hover::before { transform: scaleX(1); }
.lesson-node:hover { transform: translateY(-4px); border-color: var(--border-glow); box-shadow: var(--shadow-neon); }
.lesson-node.completed {
  border-color: rgba(0,255,136,0.4);
  background: rgba(0,255,136,0.05);
}
.lesson-node.completed::before { transform: scaleX(1); background: var(--accent-green); }
.lesson-node.locked { opacity: 0.4; cursor: not-allowed; filter: grayscale(0.5); }
.lesson-node.locked:hover { transform: none; box-shadow: none; }
.lesson-node.current {
  border-color: rgba(0,212,255,0.6);
  animation: current-pulse 2s infinite;
}
@keyframes current-pulse {
  0%,100% { box-shadow: 0 0 10px rgba(0,212,255,0.3); }
  50% { box-shadow: 0 0 25px rgba(0,212,255,0.7); }
}
.node-icon { font-size: 1.8rem; margin-bottom: 0.6rem; display: block; }
.node-title { font-family: var(--font-display); font-size: 0.75rem; color: var(--text-primary); margin-bottom: 0.4rem; letter-spacing: 1px; }
.node-meta { display: flex; justify-content: space-between; align-items: center; margin-top: 0.8rem; }
.node-xp { font-family: var(--font-mono); font-size: 0.7rem; color: var(--accent-orange); }
.node-diff { font-size: 0.65rem; padding: 0.15rem 0.4rem; border-radius: 4px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; }
.diff-easy { background: rgba(0,255,136,0.15); color: var(--accent-green); }
.diff-medium { background: rgba(0,212,255,0.15); color: var(--accent-blue); }
.diff-hard { background: rgba(255,45,120,0.15); color: var(--accent-pink); }
.node-status { position: absolute; top: 0.7rem; right: 0.7rem; font-size: 0.85rem; }
.node-time { font-size: 0.65rem; color: var(--text-dim); margin-top: 0.3rem; }
/* ============================================
   LESSON VIEWER
   ============================================ */
#page-lesson { padding: 80px 0 4rem; }
.lesson-layout {
  display: grid; grid-template-columns: 280px 1fr;
  min-height: calc(100vh - 64px); gap: 0;
}
.lesson-sidebar {
  background: var(--bg-secondary); border-right: 1px solid rgba(255,255,255,0.06);
  padding: 2rem 1rem; overflow-y: auto; position: sticky; top: 64px;
  height: calc(100vh - 64px);
}
.sidebar-title { font-family: var(--font-display); font-size: 0.7rem; color: var(--text-dim); text-transform: uppercase; letter-spacing: 3px; margin-bottom: 1rem; }
.sidebar-item {
  display: flex; align-items: center; gap: 0.7rem;
  padding: 0.7rem 0.8rem; border-radius: 8px; cursor: pointer;
  transition: var(--transition); font-size: 0.85rem; color: var(--text-secondary);
  margin-bottom: 0.2rem;
}
.sidebar-item:hover { background: rgba(255,255,255,0.05); color: var(--text-primary); }
.sidebar-item.active { background: rgba(0,212,255,0.1); color: var(--accent-cyan); border-left: 3px solid var(--accent-cyan); }
.sidebar-item.done { color: var(--accent-green); }
.sidebar-item .si-icon { font-size: 1rem; width: 20px; text-align: center; }
.lesson-content { padding: 3rem; overflow-y: auto; }
.lesson-title { font-family: var(--font-display); font-size: 2rem; margin-bottom: 0.5rem; }
.lesson-meta-bar {
  display: flex; gap: 1rem; margin-bottom: 2rem; flex-wrap: wrap; align-items: center;
}
.lesson-meta-bar span { font-size: 0.8rem; color: var(--text-secondary); }
.lesson-meta-bar .badge {
  font-family: var(--font-mono); font-size: 0.7rem; padding: 0.2rem 0.6rem;
  border-radius: 4px; background: rgba(0,212,255,0.1); color: var(--accent-cyan); border: 1px solid rgba(0,212,255,0.3);
}
/* Theory sections */
.theory-block { margin-bottom: 2.5rem; }
.theory-block h3 { font-family: var(--font-display); font-size: 1rem; color: var(--accent-cyan); margin-bottom: 1rem; letter-spacing: 1px; }
.theory-block p { color: var(--text-secondary); line-height: 1.8; font-size: 0.95rem; margin-bottom: 1rem; }
.theory-block ul { color: var(--text-secondary); font-size: 0.95rem; padding-left: 1.5rem; line-height: 2; }
/* Code blocks */
.code-block {
  background: #070710; border: 1px solid rgba(255,255,255,0.08);
  border-radius: var(--radius); overflow: hidden; margin: 1.5rem 0;
}
.code-header {
  display: flex; align-items: center; justify-content: space-between;
  background: rgba(255,255,255,0.03); padding: 0.6rem 1rem; border-bottom: 1px solid rgba(255,255,255,0.06);
}
.code-lang { font-family: var(--font-mono); font-size: 0.7rem; color: var(--accent-purple); text-transform: uppercase; letter-spacing: 2px; }
.code-run-btn {
  background: linear-gradient(135deg, var(--accent-green), #00cc66);
  border: none; color: #000; font-family: var(--font-mono); font-size: 0.7rem;
  font-weight: 700; padding: 0.3rem 0.8rem; border-radius: 4px; cursor: pointer;
  transition: var(--transition); text-transform: uppercase; letter-spacing: 1px;
}
.code-run-btn:hover { transform: scale(1.05); box-shadow: 0 0 15px rgba(0,255,136,0.4); }
.code-editor {
  font-family: var(--font-mono); font-size: 0.85rem; line-height: 1.7;
  background: transparent; border: none; outline: none; resize: none;
  width: 100%; padding: 1.2rem; color: var(--text-primary);
  caret-color: var(--accent-cyan);
}
.code-output {
  background: rgba(0,0,0,0.4); border-top: 1px solid rgba(255,255,255,0.06);
  padding: 1rem; font-family: var(--font-mono); font-size: 0.82rem;
  color: var(--accent-green); min-height: 60px; white-space: pre-wrap;
}
.code-output.error { color: var(--accent-pink); }
/* Interactive demos */
.demo-box {
  background: var(--bg-glass); border: 1px solid rgba(255,255,255,0.08);
  border-radius: var(--radius); padding: 2rem; margin: 1.5rem 0;
  backdrop-filter: blur(5px);
}
.demo-title { font-family: var(--font-display); font-size: 0.8rem; color: var(--accent-orange); text-transform: uppercase; letter-spacing: 2px; margin-bottom: 1.5rem; }
/* Array visualizer */
.array-viz { display: flex; gap: 0.5rem; flex-wrap: wrap; margin: 1rem 0; }
.array-cell {
  width: 52px; height: 52px; background: rgba(0,212,255,0.1);
  border: 2px solid rgba(0,212,255,0.4); border-radius: 8px;
  display: flex; align-items: center; justify-content: center;
  font-family: var(--font-mono); font-size: 0.9rem; color: var(--accent-cyan);
  font-weight: 700; transition: var(--transition); cursor: pointer;
  position: relative;
}
.array-cell:hover { background: rgba(0,212,255,0.2); transform: scale(1.1); }
.array-cell.highlight { background: rgba(0,255,136,0.2); border-color: var(--accent-green); color: var(--accent-green); animation: cell-pop 0.3s ease; }
@keyframes cell-pop { 0% { transform: scale(0.8); } 60% { transform: scale(1.2); } 100% { transform: scale(1); } }
.array-index { position: absolute; bottom: -20px; font-size: 0.6rem; color: var(--text-dim); }
/* Loop visualizer */
.loop-viz { display: flex; flex-direction: column; gap: 0.5rem; }
.loop-step {
  display: flex; align-items: center; gap: 1rem; padding: 0.7rem 1rem;
  background: rgba(255,255,255,0.03); border-radius: 8px; border-left: 3px solid transparent;
  transition: var(--transition); font-family: var(--font-mono); font-size: 0.85rem;
}
.loop-step.active { border-left-color: var(--accent-cyan); background: rgba(0,212,255,0.08); color: var(--accent-cyan); }
.loop-step.done { border-left-color: var(--accent-green); color: var(--accent-green); opacity: 0.7; }
/* Scope diagram */
.scope-viz { position: relative; padding: 1rem; }
.scope-box {
  border: 2px dashed; border-radius: var(--radius); padding: 1.5rem;
  margin: 0.5rem; position: relative;
}
.scope-box.global { border-color: rgba(0,212,255,0.5); }
.scope-box.function { border-color: rgba(124,58,237,0.5); margin: 1rem; }
.scope-box.block { border-color: rgba(255,107,53,0.5); margin: 1rem; }
.scope-label { position: absolute; top: -12px; left: 10px; font-family: var(--font-mono); font-size: 0.7rem; padding: 0 0.5rem; background: var(--bg-primary); }
.scope-box.global .scope-label { color: var(--accent-cyan); }
.scope-box.function .scope-label { color: var(--accent-purple); }
.scope-box.block .scope-label { color: var(--accent-orange); }
/* Event loop viz */
.event-loop-viz { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem; }
.el-box { background: rgba(255,255,255,0.03); border-radius: var(--radius); padding: 1rem; }
.el-box-title { font-family: var(--font-display); font-size: 0.65rem; color: var(--text-dim); text-transform: uppercase; letter-spacing: 2px; margin-bottom: 0.8rem; text-align: center; }
.el-item { background: rgba(0,212,255,0.1); border: 1px solid rgba(0,212,255,0.3); border-radius: 6px; padding: 0.4rem 0.7rem; margin-bottom: 0.4rem; font-family: var(--font-mono); font-size: 0.75rem; color: var(--accent-cyan); transition: var(--transition); }
.el-item.web-api { background: rgba(124,58,237,0.1); border-color: rgba(124,58,237,0.3); color: var(--accent-purple); }
.el-item.callback { background: rgba(255,107,53,0.1); border-color: rgba(255,107,53,0.3); color: var(--accent-orange); }
/* Complete lesson btn */
.lesson-complete-btn {
  width: 100%; padding: 1rem;
  background: linear-gradient(135deg, var(--accent-green), #00cc66);

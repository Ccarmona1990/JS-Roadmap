}
/* ============================================
   SCROLLBAR
   ============================================ */
::-webkit-scrollbar { width: 6px; }
::-webkit-scrollbar-track { background: var(--bg-primary); }
::-webkit-scrollbar-thumb { background: rgba(0,212,255,0.3); border-radius: 3px; }
::-webkit-scrollbar-thumb:hover { background: rgba(0,212,255,0.6); }

/* ============================================
   IOS / MOBILE TOUCH FIXES
   ============================================ */
/* Remove 300ms tap delay on all interactive elements */
a, button, input, select, textarea,
.nav-btn, .nav-logo, .lesson-node, .challenge-card,
.feat-card, .color-opt, .sidebar-item, .btn-primary,
.btn-secondary, .btn-sm, .btn-danger, .code-run-btn,
.lesson-complete-btn, .modal-close, .toggle-slider,
[onclick] {
  touch-action: manipulation;
  -webkit-tap-highlight-color: transparent;
}
/* iOS Safari requires cursor:pointer for click events on non-button divs */
.nav-logo, .lesson-node, .challenge-card, .feat-card,
.color-opt, .sidebar-item, .ach-card {
  cursor: pointer;
}
/* Prevent accidental text selection on tap */
.lesson-node, .challenge-card, .feat-card, .nav-btn,
.btn-primary, .btn-secondary, .sidebar-item, .nav-logo {
  -webkit-user-select: none;
  user-select: none;
}
/* Smooth momentum scrolling in scrollable containers */
.lesson-sidebar, .modal-box, .lesson-content {
  -webkit-overflow-scrolling: touch;
}


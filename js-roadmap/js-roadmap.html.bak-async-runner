function runCode(btn) {
  const block = btn.closest('.code-block');
  const editor = block.querySelector('.code-editor');
  const output = block.querySelector('.code-output');
  executeCode(editor.value, output);
}

function executeCode(code, outputEl) {
  const logs = [];
  const origLog = console.log;
  const origWarn = console.warn;
  const origError = console.error;
  console.log = (...a) => { logs.push(a.map(x => stringify(x)).join(' ')); origLog(...a); };
  console.warn = (...a) => { logs.push('⚠️ ' + a.map(x=>stringify(x)).join(' ')); origWarn(...a); };
  console.error = (...a) => { logs.push('❌ ' + a.map(x=>stringify(x)).join(' ')); origError(...a); };
  try {
    eval(code);
    outputEl.textContent = logs.length ? logs.join('\n') : '// (no output)';
    outputEl.className = 'code-output';
  } catch(e) {
    outputEl.textContent = '❌ ' + e.toString();
    outputEl.className = 'code-output error';
  }
  console.log = origLog; console.warn = origWarn; console.error = origError;
}

function stringify(val) {
  if (val === null) return 'null';
  if (val === undefined) return 'undefined';
  if (Array.isArray(val)) return '[' + val.map(stringify).join(', ') + ']';
  if (typeof val === 'object') return JSON.stringify(val);
  return String(val);
}


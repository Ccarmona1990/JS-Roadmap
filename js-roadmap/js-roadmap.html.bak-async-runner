      showAchievementPopup(a);
    }
  });
  updateNavStats();
}

function showAchievementPopup(a) {
  const popup = document.createElement('div');
  popup.className = 'ach-popup';
  popup.innerHTML = `<div class="ach-popup-icon">${a.icon}</div><div class="ach-popup-text"><div class="label">Achievement Unlocked!</div><div class="name">${a.name}</div></div>`;
  document.body.appendChild(popup);
  setTimeout(() => popup.remove(), 3500);
}

// ============================================
// XP POPUP
// ============================================
function showXPPopup(amount, label) {
  if (amount === 0 && label) {
    const popup = document.createElement('div');
    popup.className = 'xp-popup';
    popup.style.background = 'linear-gradient(135deg, var(--accent-purple), var(--accent-blue))';
    popup.textContent = label;
    document.body.appendChild(popup);
    setTimeout(() => popup.remove(), 2500);
    return;
  }
  if (!amount) return;
  const popup = document.createElement('div');
  popup.className = 'xp-popup';
  popup.textContent = label || `+${amount} XP`;
  document.body.appendChild(popup);
  setTimeout(() => popup.remove(), 2500);
}

// ============================================
// SETTINGS
// ============================================
function applySettings() {
  if (state.settings?.theme === 'light') { document.documentElement.setAttribute('data-theme','light'); document.getElementById('toggle-theme').checked = true; }
  if (state.settings?.sound) document.getElementById('toggle-sound').checked = true;
}
function toggleTheme() {
  const isLight = document.getElementById('toggle-theme').checked;
  document.documentElement.setAttribute('data-theme', isLight?'light':'dark');
  if (!state.settings) state.settings = {};
  state.settings.theme = isLight ? 'light' : 'dark';
  saveState();
}
function toggleAnimations() {}
function toggleSound() { if (!state.settings) state.settings = {}; state.settings.sound = document.getElementById('toggle-sound').checked; saveState(); }
function setAccent(color, glowColor, el) {
  document.documentElement.style.setProperty('--accent-blue', color);
  document.documentElement.style.setProperty('--border-glow', glowColor+'55');
  document.querySelectorAll('.color-opt').forEach(e => e.classList.remove('active'));
  el.classList.add('active');
  if (!state.settings) state.settings = {};
  state.settings.accent = color;
  saveState();
}
function resetProgress() {
  if (confirm('⚠️ Reset ALL progress? This cannot be undone!')) {
    localStorage.removeItem('jsquest-state');
    state = { xp:0, level:1, streak:0, completed:[], solvedChallenges:[], achievements:[], lastVisit:null, settings:{theme:'dark',accent:'#00d4ff',animations:true,sound:false} };
    saveState(); updateNavStats();
    showXPPopup(0, '🔄 Progress Reset');
  }
}

// ============================================
// KEYBOARD SHORTCUTS
// ============================================
document.addEventListener('keydown', e => {
  if (e.target.tagName === 'TEXTAREA' || e.target.tagName === 'INPUT') {
    if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
      const block = e.target.closest('.code-block');
      if (block) { const btn = block.querySelector('.code-run-btn'); if (btn) btn.click(); }
      e.preventDefault();
    }
    return;
  }
  if (e.key === 'Escape') closeChallenge();
  if (e.key === '1') showPage('landing');
  if (e.key === '2') showPage('roadmap');
  if (e.key === '3') showPage('practice');
  if (e.key === '4') showPage('profile');
  if (e.key === '5') showPage('settings');
});

// Close modal on overlay click
const modalEl = document.getElementById('challenge-modal');
modalEl.addEventListener('click', function(e) { if (e.target === this) closeChallenge(); });
modalEl.addEventListener('touchend', function(e) { if (e.target === this) { e.preventDefault(); closeChallenge(); } }, { passive: false });

// ============================================
// BACKGROUND CANVAS ANIMATION
// ============================================
function initCanvas() {
  const canvas = document.getElementById('bg-canvas');
  const ctx = canvas.getContext('2d');
  let W = canvas.width = window.innerWidth;
  let H = canvas.height = window.innerHeight;
  window.addEventListener('resize', () => { W = canvas.width = window.innerWidth; H = canvas.height = window.innerHeight; });

  const particles = Array.from({length:60}, () => ({
    x: Math.random()*W, y: Math.random()*H,
    vx: (Math.random()-0.5)*0.4, vy: (Math.random()-0.5)*0.4,
    size: Math.random()*2+0.5,
    alpha: Math.random()*0.5+0.1,
    color: ['#00d4ff','#7c3aed','#06ffd4','#ff6b35'][Math.floor(Math.random()*4)]
  }));

  function draw() {
    ctx.clearRect(0, 0, W, H);
    particles.forEach(p => {
      p.x += p.vx; p.y += p.vy;
      if (p.x < 0) p.x = W; if (p.x > W) p.x = 0;
      if (p.y < 0) p.y = H; if (p.y > H) p.y = 0;
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.size, 0, Math.PI*2);
      ctx.fillStyle = p.color;
      ctx.globalAlpha = p.alpha;
      ctx.fill();
    });
    // Draw connections
    ctx.globalAlpha = 0.06;
    particles.forEach((a,i) => {
      particles.slice(i+1).forEach(b => {
        const d = Math.hypot(a.x-b.x, a.y-b.y);
        if (d < 120) {
          ctx.beginPath(); ctx.moveTo(a.x,a.y); ctx.lineTo(b.x,b.y);
          ctx.strokeStyle = '#00d4ff'; ctx.lineWidth = 0.5; ctx.stroke();
        }
      });
    });
    requestAnimationFrame(draw);
  }
  draw();
}

// ============================================
// INIT
// ============================================
window.addEventListener('DOMContentLoaded', () => {
  loadState();
  updateNavStats();
  initCanvas();
  renderArrayViz();
  updateVarDemo();
  // Mark first nav btn active
  document.querySelectorAll('.nav-btn')[0]?.classList.add('active');
});

  display: flex; align-items: center; justify-content: center;
  font-size: 3rem; margin: 0 auto 1.2rem; border: 4px solid var(--accent-cyan);
  box-shadow: 0 0 30px rgba(0,212,255,0.5);
}
.profile-name { font-family: var(--font-display); font-size: 1.3rem; margin-bottom: 0.3rem; }
.profile-rank-badge {
  display: inline-block; background: rgba(255,107,53,0.15); border: 1px solid rgba(255,107,53,0.4);
  color: var(--accent-orange); font-size: 0.8rem; font-weight: 700;
  padding: 0.3rem 0.8rem; border-radius: 20px; letter-spacing: 2px; margin-bottom: 1.5rem;
}
.profile-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; text-align: center; }
.pstat { background: rgba(255,255,255,0.03); border-radius: 8px; padding: 0.8rem; }
.pstat .val { font-family: var(--font-display); font-size: 1.5rem; display: block; }
.pstat .val.blue { color: var(--accent-cyan); }
.pstat .val.purple { color: var(--accent-purple); }
.pstat .val.orange { color: var(--accent-orange); }
.pstat .val.green { color: var(--accent-green); }
.pstat .lbl { font-size: 0.7rem; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 1px; }
/* Achievements */
.achievements-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px,1fr)); gap: 1rem; }
.ach-card {
  background: var(--bg-glass); border: 1px solid rgba(255,255,255,0.06);
  border-radius: var(--radius); padding: 1.2rem; text-align: center;
  transition: var(--transition); backdrop-filter: blur(5px);
}
.ach-card.unlocked { border-color: rgba(255,215,0,0.4); background: rgba(255,215,0,0.05); }
.ach-card.locked { opacity: 0.35; filter: grayscale(1); }
.ach-icon { font-size: 2rem; margin-bottom: 0.5rem; display: block; }
.ach-name { font-family: var(--font-display); font-size: 0.65rem; color: var(--text-primary); margin-bottom: 0.3rem; letter-spacing: 1px; }
.ach-desc { font-size: 0.7rem; color: var(--text-secondary); }
/* Skill mastery bars */
.skill-bars { display: flex; flex-direction: column; gap: 1rem; }
.skill-bar-top { display: flex; justify-content: space-between; margin-bottom: 0.4rem; }
.skill-bar-name { font-size: 0.85rem; color: var(--text-primary); }
.skill-bar-pct { font-family: var(--font-mono); font-size: 0.8rem; color: var(--accent-cyan); }
.skill-bar-track { height: 6px; background: rgba(255,255,255,0.05); border-radius: 3px; overflow: hidden; }
.skill-bar-fill { height: 100%; border-radius: 3px; transition: width 1.5s cubic-bezier(0.4,0,0.2,1); }
/* ============================================
   SETTINGS
   ============================================ */
#page-settings { padding: 80px 2rem 4rem; }
.settings-container { max-width: 700px; margin: 2rem auto; }
.settings-section {
  background: var(--bg-glass); border: 1px solid rgba(255,255,255,0.06);
  border-radius: var(--radius-lg); padding: 2rem; margin-bottom: 1.5rem; backdrop-filter: blur(5px);
}
.settings-section h3 { font-family: var(--font-display); font-size: 0.9rem; color: var(--accent-cyan); margin-bottom: 1.5rem; letter-spacing: 2px; text-transform: uppercase; }
.setting-row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 0.8rem 0; border-bottom: 1px solid rgba(255,255,255,0.04);
}
.setting-row:last-child { border-bottom: none; }
.setting-label { font-size: 0.9rem; color: var(--text-primary); }
.setting-desc { font-size: 0.75rem; color: var(--text-secondary); margin-top: 0.2rem; }
/* Toggle */
.toggle { position: relative; width: 48px; height: 26px; }
.toggle input { display: none; }
.toggle-slider {
  position: absolute; top:0; left:0; right:0; bottom:0;
  background: rgba(255,255,255,0.1); border-radius: 13px; cursor: pointer;
  transition: var(--transition);
}
.toggle-slider::before {
  content: ''; position: absolute; width: 20px; height: 20px;
  left: 3px; top: 3px; background: var(--text-secondary); border-radius: 50%;
  transition: var(--transition);
}
.toggle input:checked + .toggle-slider { background: linear-gradient(135deg, var(--accent-blue), var(--accent-purple)); }
.toggle input:checked + .toggle-slider::before { transform: translateX(22px); background: white; }
/* Color pickers */
.color-row { display: flex; gap: 0.8rem; flex-wrap: wrap; }
.color-opt {
  width: 36px; height: 36px; border-radius: 50%; cursor: pointer;
  border: 3px solid transparent; transition: var(--transition);
}
.color-opt:hover, .color-opt.active { border-color: white; transform: scale(1.15); }
/* Reset btn */
.btn-danger {
  background: rgba(255,45,120,0.15); color: var(--accent-pink);
  border: 1px solid rgba(255,45,120,0.4); padding: 0.7rem 1.5rem;
  font-family: var(--font-display); font-size: 0.8rem; font-weight: 700;
  border-radius: var(--radius); cursor: pointer; letter-spacing: 1px; text-transform: uppercase;
  transition: var(--transition);
}
.btn-danger:hover { background: rgba(255,45,120,0.25); box-shadow: 0 0 15px rgba(255,45,120,0.3); }
/* ============================================
   XP POPUP
   ============================================ */
.xp-popup {
  position: fixed; bottom: 2rem; right: 2rem; z-index: 9999;
  background: linear-gradient(135deg, var(--accent-green), #00cc66);
  color: #000; font-family: var(--font-display); font-size: 1.1rem; font-weight: 900;
  padding: 0.8rem 1.5rem; border-radius: 30px;
  box-shadow: 0 0 30px rgba(0,255,136,0.6);
  animation: xp-fly 2.5s ease forwards;
  pointer-events: none; letter-spacing: 2px;
}
@keyframes xp-fly {
  0% { opacity: 0; transform: translateY(20px) scale(0.8); }
  20% { opacity: 1; transform: translateY(0) scale(1.05); }
  70% { opacity: 1; transform: translateY(-20px); }
  100% { opacity: 0; transform: translateY(-60px); }
}
/* Achievement popup */
.ach-popup {
  position: fixed; bottom: 2rem; left: 2rem; z-index: 9999;
  background: var(--bg-secondary); border: 2px solid gold;
  border-radius: var(--radius); padding: 1rem 1.5rem;
  box-shadow: 0 0 30px rgba(255,215,0,0.4);
  animation: ach-slide 3s ease forwards;
  pointer-events: none; display: flex; gap: 1rem; align-items: center;
  max-width: 300px;
}
@keyframes ach-slide {
  0% { opacity: 0; transform: translateX(-50px); }
  15% { opacity: 1; transform: translateX(0); }
  75% { opacity: 1; }
  100% { opacity: 0; transform: translateX(-50px); }
}
.ach-popup-icon { font-size: 2rem; }
.ach-popup-text .label { font-size: 0.65rem; color: gold; text-transform: uppercase; letter-spacing: 2px; }
.ach-popup-text .name { font-family: var(--font-display); font-size: 0.9rem; color: var(--text-primary); }
/* ============================================
   KEYBOARD SHORTCUT HINT
   ============================================ */
.shortcut-hint {
  position: fixed; bottom: 1rem; left: 50%; transform: translateX(-50%);
  background: rgba(0,0,0,0.7); border: 1px solid rgba(255,255,255,0.1);
  color: var(--text-dim); font-family: var(--font-mono); font-size: 0.7rem;
  padding: 0.4rem 1rem; border-radius: 20px; z-index: 100;
  pointer-events: none;
}
kbd { background: rgba(255,255,255,0.1); border-radius: 3px; padding: 0.1rem 0.4rem; margin: 0 0.2rem; }
/* ============================================
   SECTION HEADINGS (profile/settings)
   ============================================ */
.section-heading {
  font-family: var(--font-display); font-size: 0.8rem; color: var(--text-dim);
  text-transform: uppercase; letter-spacing: 3px; margin-bottom: 1.5rem;
  padding-bottom: 0.5rem; border-bottom: 1px solid rgba(255,255,255,0.05);
}
.card-block {
  background: var(--bg-glass); border: 1px solid rgba(255,255,255,0.06);
  border-radius: var(--radius-lg); padding: 2rem; backdrop-filter: blur(5px); margin-bottom: 1.5rem;
}
/* ============================================
   RESPONSIVE
   ============================================ */
@media (max-width: 900px) {

function showPage(id) {
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
  const pageEl = document.getElementById('page-'+id);
  if (!pageEl) return;
  pageEl.classList.add('active');
  const pages = ['landing','roadmap','practice','profile','settings'];
  const idx = pages.indexOf(id);
  if (idx >= 0) document.querySelectorAll('.nav-btn')[idx]?.classList.add('active');
  if (id === 'lesson') document.querySelectorAll('.nav-btn')[1]?.classList.add('active');
  if (id === 'roadmap') renderRoadmap();
  if (id === 'profile') renderProfile();
  if (id === 'practice') renderChallenges();
  // Scroll to the content area of the selected page (right below the nav)
  const navHeight = document.querySelector('nav')?.offsetHeight || 64;
  requestAnimationFrame(() => {
    const pageTop = pageEl.getBoundingClientRect().top + window.scrollY - navHeight;
    window.scrollTo({ top: pageTop, behavior: 'smooth' });
  });
}


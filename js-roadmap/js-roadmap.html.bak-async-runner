function openLesson(id) {
  const lesson = LESSONS.find(l => l.id === id);
  if (!lesson) return;
  showPage('lesson');
  renderLesson(lesson);
}

function renderLesson(lesson) {
  const main = document.getElementById('lesson-main');
  const catName = CATEGORIES[lesson.cat]?.label || lesson.cat;
  const challengeBlock = getLessonChallenge(lesson.id);
  main.innerHTML = `
    <div class="lesson-title">${lesson.icon} ${lesson.title}</div>
    <div class="lesson-meta-bar">
      <span class="badge">${catName}</span>
      <span class="badge diff-${lesson.diff}">${lesson.diff}</span>
      <span>⏱ ${lesson.time}</span>
      <span>⚡ +${lesson.xp} XP</span>
    </div>
    ${getLessonContent(lesson)}
    ${challengeBlock}
    <button class="lesson-complete-btn" id="complete-btn" onclick="completeLesson('${lesson.id}', ${lesson.xp})">
      ${state.completed.includes(lesson.id) ? '✅ ALREADY COMPLETED' : '✔ MARK COMPLETE · EARN ' + lesson.xp + ' XP'}
    </button>`;

  // Add id anchors so the TOC buttons can scroll to each section
  const theoryEl    = main.querySelector('.theory-block');
  const exampleEl   = main.querySelector('.code-block');
  const demoEl      = main.querySelector('.demo-box');
  const challengeEl = main.querySelector('.lesson-challenge-block');
  if (theoryEl)    theoryEl.id    = 'section-theory';
  if (exampleEl)   exampleEl.id   = 'section-example';
  if (demoEl)      demoEl.id      = 'section-demo';
  if (challengeEl) challengeEl.id = 'section-challenge';

  // Build TOC sidebar — each item scrolls to its section
  const toc = document.getElementById('lesson-toc');
  toc.innerHTML = '';
  const tocSections = [
    { label: 'Theory',               icon: '📖', anchor: 'section-theory',    el: theoryEl },
    { label: 'Interactive Example',  icon: '💻', anchor: 'section-example',   el: exampleEl },
    { label: 'Visual Demo',          icon: '🎨', anchor: 'section-demo',      el: demoEl },
    { label: 'Challenge',            icon: '⚔️', anchor: 'section-challenge', el: challengeEl },
  ];
  tocSections.forEach((s, i) => {
    const item = document.createElement('div');
    const exists = !!s.el;
    item.className = 'sidebar-item' +
      (i === 0 && exists ? ' active' : '') +
      (state.completed.includes(lesson.id) ? ' done' : '');
    if (!exists) item.style.opacity = '0.3';
    item.innerHTML = `<span class="si-icon">${s.icon}</span>${s.label}`;
    if (exists) {
      const go = () => {
        document.querySelectorAll('.sidebar-item').forEach(el => el.classList.remove('active'));
        item.classList.add('active');
        const target = document.getElementById(s.anchor);
        if (!target) return;
        const navH = document.querySelector('nav')?.offsetHeight || 64;
        const top = target.getBoundingClientRect().top + window.scrollY - navH - 16;
        window.scrollTo({ top, behavior: 'smooth' });
      };
      item.addEventListener('touchend', (e) => { e.preventDefault(); go(); }, { passive: false });
      item.addEventListener('click', go);
    }
    toc.appendChild(item);
  });
}


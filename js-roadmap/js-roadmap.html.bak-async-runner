  document.getElementById('rm-xp-bar').style.width = Math.min(pct,100)+'%';
  document.getElementById('rm-level').textContent = state.level;
  document.getElementById('rm-done').textContent = state.completed.length;
  document.getElementById('rm-streak').textContent = state.streak;
  document.getElementById('rm-ach').textContent = state.achievements.length;
  document.getElementById('player-rank-text').textContent = getRank();

  const container = document.getElementById('roadmap-sections');
  container.innerHTML = '';
  const catOrder = ['foundation','core','advanced','advanced-dom','projects'];

  for (const catId of catOrder) {
    const cat = CATEGORIES[catId];
    const lessons = LESSONS.filter(l => l.cat === catId);
    const done = lessons.filter(l => state.completed.includes(l.id)).length;

    const section = document.createElement('div');
    section.className = 'roadmap-section';
    section.innerHTML = `
      <div class="section-header">
        <div class="section-badge" style="background:linear-gradient(135deg,${cat.color},rgba(0,0,0,0.3))">${cat.badge}</div>
        <div class="section-title">${cat.label}</div>
        <div class="section-prog">${done}/${lessons.length}</div>
      </div>
      <div class="lessons-grid" id="grid-${catId}"></div>`;
    container.appendChild(section);

    const grid = section.querySelector('.lessons-grid');
    lessons.forEach((lesson, i) => {
      const isDone = state.completed.includes(lesson.id);
      const isLocked = !isDone && catId !== 'foundation' && i > 0 && !state.completed.includes(lessons[i-1]?.id) && state.xp < 50;
      const node = document.createElement('div');
      node.className = `lesson-node ${isDone?'completed':''} ${isLocked?'locked':''}`;
      node.innerHTML = `
        <span class="node-icon">${lesson.icon}</span>
        <div class="node-title">${lesson.title}</div>
        <div class="node-time">⏱ ${lesson.time}</div>
        <div class="node-meta">
          <span class="node-xp">+${lesson.xp} XP</span>
          <span class="node-diff diff-${lesson.diff}">${lesson.diff}</span>
        </div>
        <div class="node-status">${isDone ? '✅' : isLocked ? '🔒' : '▶'}</div>`;
      if (!isLocked) {
        node.addEventListener('click', () => openLesson(lesson.id));
        node.style.cursor = 'pointer';
        node.addEventListener('mouseenter', () => {
          if (!isLocked) node.title = `${lesson.desc} · ${lesson.xp} XP`;
        });
      }
      grid.appendChild(node);
    });
  }
}


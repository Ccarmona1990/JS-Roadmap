function getEventDelegationContent() {
  return `
  <div class="theory-block">
    <h3>📖 Event Delegation — Efficient Event Handling</h3>
    <p>Instead of adding listeners to every child element, add ONE listener to the parent and check <code style="color:var(--accent-cyan)">event.target</code>.</p>
    <ul>
      <li>Events <strong style="color:var(--accent-cyan)">bubble up</strong> from child → parent → document</li>
      <li><code style="color:var(--accent-purple)">event.target</code> — the actual element clicked</li>
      <li><code style="color:var(--accent-orange)">event.currentTarget</code> — the element with the listener</li>
      <li><code style="color:var(--accent-green)">event.target.matches(selector)</code> — filter by CSS selector</li>
    </ul>
  </div>
  <div class="code-block">
    <div class="code-header"><span class="code-lang">javascript</span><button class="code-run-btn" onclick="runCode(this)">▶ RUN</button></div>
    <textarea class="code-editor" rows="20" spellcheck="false">// WITHOUT delegation — bad for dynamic lists
// button1.addEventListener('click', fn);
// button2.addEventListener('click', fn);
// button3.addEventListener('click', fn);
// ... need to add for EVERY new button!

// WITH delegation — one listener handles all
// Simulate a parent element
const parent = document.createElement('ul');
const items = ['Apples', 'Bananas', 'Cherries'];

items.forEach(text => {
  const li = document.createElement('li');
  li.textContent = text;
  li.dataset.item = text;
  parent.appendChild(li);
});

// One listener on parent catches all children
parent.addEventListener('click', (e) => {
  if (e.target.tagName === 'LI') {
    console.log("Clicked:", e.target.dataset.item);
  }
});

// Simulate clicks
parent.children[0].click(); // Apples
parent.children[2].click(); // Cherries
console.log("Only 1 listener needed for all items!");</textarea>
    <div class="code-output">// Click RUN to see output</div>
  </div>`;
}

// LocalStorage demo helpers
function lsSave() {
  const val = document.getElementById('ls-input')?.value;
  if (!val) return;
  localStorage.setItem('jsquest-demo-note', val);
  const st = document.getElementById('ls-status');
  if (st) st.textContent = '✅ Saved: "' + val + '"';
}
function lsLoad() {
  const val = localStorage.getItem('jsquest-demo-note');
  const st = document.getElementById('ls-status');
  if (st) st.textContent = val ? '📂 Loaded: "' + val + '"' : '⚠️ Nothing saved yet';
  const inp = document.getElementById('ls-input');
  if (inp && val) inp.value = val;
}
function lsClear() {
  localStorage.removeItem('jsquest-demo-note');
  const st = document.getElementById('ls-status');
  if (st) st.textContent = '🗑 Cleared from localStorage';
  const inp = document.getElementById('ls-input');
  if (inp) inp.value = '';
}

// Dynamic element builder helpers
let dynCount = 0;
function dynAdd() {
  const txt = document.getElementById('dyn-text')?.value || 'Element ' + ++dynCount;
  const container = document.getElementById('dyn-container');
  if (!container) return;
  const el = document.createElement('div');
  const colors = ['var(--accent-cyan)','var(--accent-purple)','var(--accent-orange)','var(--accent-green)','var(--accent-pink)'];
  const color = colors[dynCount % colors.length];
  dynCount++;
  el.style.cssText = `background:rgba(0,0,0,0.3); border-left:3px solid ${color}; padding:0.6rem 1rem; margin-bottom:0.5rem; border-radius:4px; font-family:var(--font-mono); font-size:0.85rem; color:${color}; display:flex; justify-content:space-between; animation:cell-pop 0.3s ease;`;
  el.innerHTML = `<span>&lt;div&gt; ${txt} &lt;/div&gt;</span><button onclick="this.parentElement.remove()" style="background:none;border:none;color:#ff2d78;cursor:pointer;font-size:1rem;">✕</button>`;
  container.appendChild(el);
  const inp = document.getElementById('dyn-text');
  if (inp) inp.value = '';
}
function dynClear() {
  const c = document.getElementById('dyn-container');
  if (c) c.innerHTML = '';
}


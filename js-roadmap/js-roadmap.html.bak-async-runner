}
.feedback-box.success { background: rgba(0,255,136,0.1); border: 1px solid rgba(0,255,136,0.3); color: var(--accent-green); display: block; }
.feedback-box.error { background: rgba(255,45,120,0.1); border: 1px solid rgba(255,45,120,0.3); color: var(--accent-pink); display: block; }
/* ============================================
   PROFILE / PROGRESS PAGE
   ============================================ */
#page-profile { padding: 80px 2rem 4rem; }
.profile-grid { display: grid; grid-template-columns: 340px 1fr; gap: 2rem; max-width: 1100px; margin: 2rem auto; }
.profile-left { display: flex; flex-direction: column; gap: 1.5rem; }
.profile-card {
  background: var(--bg-glass); border: 1px solid var(--border-glow);
  border-radius: var(--radius-lg); padding: 2rem; text-align: center; backdrop-filter: blur(10px);
}
.profile-avatar {
